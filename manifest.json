{
  "manifest_version": 3,
  "name": "AQW IoDA Preview",
  "version": "1.0.0",
  "description": "Shows item image directly on IoDA Exchange Page",
  "host_permissions": [
    "https://account.aq.com/AQW/InventoryAwesomeConfirm*",
    "http://aqwwiki.wikidot.com/*",
    "https://aqwwiki.wikidot.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://account.aq.com/AQW/InventoryAwesomeConfirm*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
